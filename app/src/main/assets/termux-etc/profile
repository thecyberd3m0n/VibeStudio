# System-wide .profile for bash(1) and sh(1)

if [ -n "$BASH_VERSION" ]; then
    if [ -f "$PREFIX/etc/bash.bashrc" ]; then
        . "$PREFIX/etc/bash.bashrc"
    fi
fi

if [ -d "$PREFIX/etc/profile.d" ]; then
    for file in "$PREFIX/etc/profile.d"/*.sh; do
        if [ -r "$file" ]; then
            . "$file"
        fi
    done
    unset file
fi

if [ -f "$PREFIX/etc/motd" ] && [ -z "$TERMUX_QUIET_BUILD" ]; then
    cat "$PREFIX/etc/motd"
fi
