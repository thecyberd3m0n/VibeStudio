<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="-1px"
    android:layout_height="-1px"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="20dp">

    <!-- Top Stepper Header Bar -->
    <LinearLayout
        android:layout_width="-1px"
        android:layout_height="-2px"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Step 1 Item -->
        <LinearLayout
            android:layout_width="-2px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/step1_indicator"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_step_circle_active"
                android:textColor="#FFFFFF"
                android:text="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/step1_title"
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Welcome"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:id="@+id/step_divider"
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#333333"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp" />

        <!-- Step 2 Item -->
        <LinearLayout
            android:layout_width="-2px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/step2_indicator"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_step_circle_inactive"
                android:textColor="#888888"
                android:text="2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/step2_title"
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Features"
                android:textColor="#666666"
                android:textSize="13sp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Content Card Area -->
    <FrameLayout
        android:layout_width="-1px"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:padding="24dp">

        <!-- Step 1 Content -->
        <LinearLayout
            android:id="@+id/step1_layout"
            android:layout_width="-1px"
            android:layout_height="-1px"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="🚀"
                android:textSize="72sp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Welcome to VibeStudio"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Your modern, portable AI-driven development environment running natively on Android."
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Step 2 Content -->
        <LinearLayout
            android:id="@+id/step2_layout"
            android:layout_width="-1px"
            android:layout_height="-1px"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="⚡"
                android:textSize="72sp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Powerful Toolkit"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Seamlessly manage AI models, connect MCP tools, run shell commands in built-in terminal and chat with AI."
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Action Navigation -->
    <LinearLayout
        android:layout_width="-1px"
        android:layout_height="-2px"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Back"
            android:textColor="#CCCCCC"
            android:background="@drawable/bg_btn_secondary"
            android:textSize="15sp"
            android:visibility="invisible"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginLeft="8dp" />

    </LinearLayout>

</LinearLayout>
